# Copy to .env and edit. .env is gitignored. Every key here is one the code
# reads; commented keys show their default.

# ─── Server (server.py) ─────────────────────────────────────────────────
# Bind interface and port for `python3 server.py`. The default host is
# loopback, so a local run doesn't expose the app on the LAN. Set 0.0.0.0
# to bind all interfaces.
# HOST=127.0.0.1
# PORT=8080

# Set to 1 for uvicorn --reload in development.
# DEBUG=0

# ─── Admin auth (core/auth.py, core/api/admin.py) ───────────────────────
# The site password. Login stays disabled while this is unset or
# "change-me".
ADMIN_PASSWORD=

# Cookie value: the session secret. Required, no default; the server refuses
# to start without it. Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_COOKIE_VALUE=

# Override the cookie name if you run several apps on the same host and
# don't want their cookies to collide.
# ADMIN_COOKIE=seed_admin

# Cookie Secure flag (1 = only sent over HTTPS). Default is on.
# Set to 0 only for HTTP-only deploys (rare; usually means TLS missing).
# ADMIN_COOKIE_SECURE=1

# ─── g-admin (core/api/gadmin.py, core/api/gadmin_panel.py) ─────────────
# Machine token for the g-admin overlay contract. Grants GET everywhere
# and PATCH-status only (never note edits, never ticket creation). Same
# value across every project that speaks the contract. It lives in the
# instance passport (.env in GCORE_DIR). gadmin.py checks it against
# incoming requests; gadmin_panel.py (the cross-project tickets panel)
# sends it to every project it proxies to.
GADMIN_TOKEN=

# Set to 1 to publish /api/gadmin/overrides.css (unbaked open-ticket
# edits reapplied on load). Off by default. This is an ephemeral layer,
# not a build step.
# GADMIN_REAPPLY=0

# Override this project's own gadmin ticket store location.
# GADMIN_DB_PATH=var/gadmin.db

# Directory gadmin_panel.py (and pages/gcore/api.py) read the instance
# manifest.json from, to find every project's domain/port. Default: the
# gp-core (or legacy gcore) checkout beside this one.
# GCORE_DIR=/srv/gp-core

# ─── Compile time (compile.py) ──────────────────────────────────────────
# compile.py writes these into the pages, so a change needs a recompile.
# It reads them from this file when the environment lacks them, so a
# manual compile matches the one on restart.

# Base URL the brain pages fetch from in the browser. Default: this server's
# admin-gated proxy (core/api/brain.py).
# BRAIN_API=/api/brain

# Where that proxy reaches the g-brain REST API. Default: a g-brain on this machine.
# BRAIN_UPSTREAM=http://127.0.0.1:8766

# The owner's public site, linked from the drawer and the top bar. The
# links are hidden when this is unset.
# OWNER_SITE_URL=https://example.com

# The host this dashboard answers on, shown in the status line. The g-admin
# bar links its ticket count to https:// plus this host, and leaves the link
# out when it is unset. The setup page's agent prompt points at it too.
# PUBLIC_HOST=command.example.com

# The brain's MCP endpoints, quoted on the install and setup pages: the
# public OAuth endpoint that hosted chats add, and the origin headless
# agents reach with Cloudflare Access service tokens. Unset, those pages
# show these example.com placeholders.
# MCP_URL=https://mcp.example.com/mcp
# MCP_HEADLESS_URL=https://brain.example.com/mcp

# Manifest auto-stub: one page per item in a JSON manifest, rendered from a
# template under core/templates/. Skipped when the manifest is absent.
# SEED_MANIFEST_PATH=data/manifest.json
# SEED_MANIFEST_PREFIX=item
# SEED_MANIFEST_TEMPLATE=stub.html

# ─── Pages ──────────────────────────────────────────────────────────────
# Each key below feeds one page's api.py. A page whose service isn't there
# shows an empty state or an error, and the rest of the site is unaffected.

# blog: the g-site admin API, reached over localhost, and its admin token.
# GSITE_URL=http://127.0.0.1:8096
GSITE_ADMIN_TOKEN=

# compute: g-env's compute-usage and compute-pace scripts and its
# temperature module. Default: the g-env checkout beside this one.
# COMPUTE_USAGE_BIN=/srv/g-env/bin/compute-usage
# COMPUTE_PACE_BIN=/srv/g-env/bin/compute-pace
# COMPUTE_TEMPERATURE_PY=/srv/g-env/context/temperature.py
# Bearer token for scripts that read the compute data without the cookie.
# Unset, only the cookie works and /api/compute/sync is closed.
# COMPUTE_READ_TOKEN=

# crons: the g-cron cache and the pulse job history. Defaults: the cache at
# ~/.cache/genv/g-cron.json, and the history at .pulse/state/cron-runs.jsonl
# under BRAIN_ROOT, which is the brain checkout beside this one.
# CRONS_CACHE=
# CRONS_RUNS=
# BRAIN_ROOT=

# hours: the time-tracking service the weekly snapshot comes from.
# WAGES_URL=http://127.0.0.1:8093

# photos: the token the photo store requires on DELETE. Unset, deletes fail.
PHOTO_DELETE_TOKEN=

# sessions: the tmux hosts the terminal page can attach to. The first name
# is this machine's own tmux; each later one is reached over ssh at the
# destination after `=`, or at its own name. Needs passwordless ssh from here.
# Unset, the page offers local tmux only.
# SESSION_HOSTS=h,b=b.example.com

# upload: where the dropbox page writes files. Default: var/uploads here.
# UPLOAD_DIR=/srv/uploads

# voice, full-dash: the voice service.
# VOICE_URL=http://127.0.0.1:8077

# design: the g-design reference cards (its apps/docs checkout), copied in
# at compile time for /design. Unset, the page says it has none.
# G_DESIGN_DOCS=/srv/g-design/apps/docs
